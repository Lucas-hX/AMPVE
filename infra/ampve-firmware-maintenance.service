[Unit]
Description=AMPVE firmware deployment reconciliation
After=neurosis-postgresql.service
Requires=neurosis-postgresql.service

[Service]
Type=oneshot
User=ampve
Group=ampve
WorkingDirectory=/home/ampve/projects/AMPVE/apps/platform
ExecStart=/home/ampve/projects/AMPVE/.venv/bin/python manage.py reconcile_firmware_deployments
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
